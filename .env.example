PORT=3000
NODE_ENV=development

# Existing Paystack keys (if still used elsewhere)
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_CALLBACK_URL=https://your-app.vercel.app/index.html

# Monnify keys for /api/monnify endpoints
MONNIFY_API_KEY=MK_TEST_your_api_key_here
MONNIFY_SECRET_KEY=your_secret_key_here
MONNIFY_CONTRACT_CODE=your_contract_code_here
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_REDIRECT_URL=https://your-app.vercel.app/receive.html
MONNIFY_SOURCE_ACCOUNT_NUMBER=your_merchant_account_number
